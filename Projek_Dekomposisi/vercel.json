{
    "functions": {
        "*.php": {
            "runtime": "vercel-php@0.6.0"
        }
    },
    "routes": [
        {
            "src": "/(.*css)",
            "dest": "/$1"
        },
        {
            "src": "/(.*js)",
            "dest": "/$1"
        },
        {
            "src": "/(.*png)",
            "dest": "/$1"
        },
        {
            "src": "/(.*jpg)",
            "dest": "/$1"
        },
        {
            "src": "/(.*svg)",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ]
}